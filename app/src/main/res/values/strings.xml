	<string name="setup_title">Watch a computer</string>
	<string name="setup_intro">Elamon shows a computer\'s load, temperatures, memory, processes and monitors live. The computer runs a small service that only paired phones can read.</string>
	<string name="setup_step_install">Install the elamond service on the computer (Linux), from the project\'s releases or your distribution.</string>
	<string name="setup_step_start">Start it as a service for your user:</string>
	<string name="setup_step_pair">Run this on the computer. It shows a QR code and a six-digit code:</string>
	<string name="setup_step_scan">Point this phone\'s camera at the QR code, or tap Add computer here and enter the code.</string>
	<string name="add_scan_hint">The easiest way: run elamond pair on the computer and point the phone\'s camera at the QR code it shows.</string>
	<string name="add_address_hint">Or enter the computer\'s address, then the six-digit code.</string>
	<string name="address">Address</string>
	<string name="address_placeholder">IP address or host name</string>

	<!-- Pairing -->
	<string name="pair_title">Pair</string>
	<string name="pair">Pair</string>
	<string name="pair_again">Pair again</string>
	<string name="pair_connecting">Connecting to %1$s…</string>
	<string name="pair_with">Pair with %1$s</string>
	<string name="pair_compare">Check that these digits match the certificate line elamond pair shows on the computer:</string>
	<string name="pair_code">Code from the computer</string>
	<string name="pair_code_hint">Six digits shown by elamond pair</string>
	<string name="pair_from_qr">The QR code identified this computer. Pair this phone with it?</string>
	<string name="pair_failed">Can\'t pair</string>
	<string name="pair_unreachable">The computer doesn\'t answer. Check that the service is running and that the phone is on the same network or VPN.</string>
	<string name="pair_cert_mismatch">Something answered at this address, but not with the certificate the computer announced. Pairing was stopped to be safe.</string>
	<string name="pair_wrong_code">Wrong code. After five wrong codes the computer needs a new one.</string>
	<string name="pair_no_pairing">The computer isn\'t waiting for a phone. Run elamond pair on it first.</string>

