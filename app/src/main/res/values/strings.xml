	<string name="cmd_pair">pair a phone: shows a QR code and a code</string>
	<string name="cmd_clients">list paired phones with their IDs</string>
	<string name="cmd_revoke">unpair one phone</string>
	<string name="cmd_revoke_all">unpair every phone</string>
	<string name="cmd_snapshot">print one reading, to see what the service finds</string>
	<string name="cmd_version">the service\'s version</string>
	<string name="help_settings">Service settings</string>
	<string name="help_settings_where">Optional, in ~/.config/elamon/elamond.toml. Restart the service after a change. The defaults:</string>
	<string name="set_port">the TCP port the app connects to</string>
	<string name="set_listen">the address to listen on; \"::\" covers IPv4 and IPv6</string>
	<string name="set_name">the name shown in the app; the host name when empty</string>
	<string name="set_mdns">announce the service on the local network, so the app finds it</string>
	<string name="set_interval">milliseconds between readings</string>
	<string name="set_history">minutes of history a phone gets when it connects</string>
	<string name="help_settings_state">The service keeps its certificate and the paired phones in ~/.local/share/elamon. Deleting that folder unpairs every phone.</string>
	<string name="help_privacy">Privacy</string>
	<string name="help_privacy_body">The phone talks to your computer directly, encrypted, and trusts only the certificate it saw when pairing. Nothing passes through any server, and the app has no trackers, ads or analytics. Each phone has its own key, which the computer can revoke; keys are kept out of Android backups. Unless control is turned on, the service only reads; with it on, it acts as your user, and every action is logged with the name of the phone that asked.</string>
