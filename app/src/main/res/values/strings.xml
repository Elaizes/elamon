	<string name="forget_title">Forget %1$s?</string>
	<string name="forget_body">This phone will stop showing it. To see it again, pair again. To also remove the phone on the computer, run elamond revoke there.</string>
	<string name="forget">Forget</string>
	<string name="offline_title">Can\'t reach %1$s</string>
	<string name="offline_body">The computer may be off or asleep, the service not running, or the phone on another network. Elamon keeps trying.</string>
	<string name="unpaired_title">This phone isn\'t paired anymore</string>
	<string name="unpaired_body">The computer no longer accepts it, maybe after elamond revoke. Run elamond pair on the computer and pair again.</string>
	<string name="cert_changed_title">The computer\'s certificate changed</string>
	<string name="cert_changed_body">This happens when the service\'s data was reset or reinstalled, but also when something else pretends to be the computer. If you didn\'t reset it, check your network before pairing again.</string>

