	<string name="home_setup_title">Watch a computer</string>
	<string name="home_setup_intro">Elamon shows a computer\'s load, temperatures, memory, processes and monitors live, and controls its services, media and power. The computer runs a small service that only paired phones can reach.</string>
	<string name="home_setup_install">Install the elamond service on the computer (Linux).</string>
	<string name="home_setup_start">Start it as a service for your user:</string>
	<string name="home_setup_pair">Run this on the computer. It shows a QR code and a six-digit code:</string>
	<string name="home_setup_scan">Point this phone\'s camera at the QR code, or tap Add computer and enter the code.</string>
	<string name="home_setup_guide">Step-by-step guide for your system</string>
	<string name="home_add_qr">The easiest way: run elamond pair on the computer and point the phone\'s camera at the QR code it shows.</string>
	<string name="home_add_or_address">Or enter the computer\'s address, then the six-digit code.</string>
	<string name="home_add_address">Address</string>
	<string name="home_add_address_hint">IP address or host name</string>
