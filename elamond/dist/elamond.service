[Unit]
Description=Elamon service: this computer's metrics for the Elamon app
# A display manager's greeter is a system user with a user manager of its own; it must not
# take the port before the person who logs in.
ConditionUser=!@system
# If it can't start (the port taken, a damaged identity), it stops trying after a minute
# or so instead of restarting forever; `systemctl --user restart elamond` tries again.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
ExecStart=/usr/bin/elamond serve
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
# Room for its connections (256 at most) and the files it reads, whatever the system's default.
LimitNOFILE=8192

[Install]
WantedBy=default.target
