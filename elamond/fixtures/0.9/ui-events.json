      "unlock": true,
      "params": [{ "id": "link", "kind": "choice", "label": "Link", "choices": [{ "value": "web", "label": "Web" }] }]
    },
    {
      "id": "unit.stop",
      "name": "Stop",
      "kind": "units",
      "icon": "pause",
      "confirm": false,
      "unlock": true,
      "params": [{ "id": "link", "kind": "choice", "label": "Link", "choices": [{ "value": "web", "label": "Web" }] }]
    },
    {
      "id": "unit.restart",
      "name": "Restart",
      "kind": "units",
      "icon": "restart",
      "confirm": false,
