        {
          "id": "events/events",
          "type": "log",
          "span": 4,
          "label": "Events",
          "scope": "events",
          "level": "info",
          "lines": 200,
          "search": true
        }
      ]
    }
  ],
  "actions": [
    { "id": "power.poweroff", "name": "Shut down", "kind": "power", "icon": "power", "confirm": true, "unlock": true, "params": [] },
