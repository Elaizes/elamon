{
  "version": "7d3a91e0c4b85f26",
  "service": {
    "id": "0123456789abcdef0123456789abcdef",
    "name": "fixture",
    "version": "9.9.9",
    "interval_ms": 1000,
    "history_seconds": 600,
    "features": ["control", "displays", "media", "power", "power_profiles", "processes", "units"],
    "endpoints": ["192.0.2.10", "100.64.0.7", "desk.example.net", "desk.tail0000.ts.net"]
  },
  "role": "admin",
  "control": { "enabled": true, "off_reason": null },
  "profile": {
    "id": "owner",
    "name": "Owner",
    "theme": "system",
    "pure_black": false,
    "animations": true,
    "interval_ms": 1000,
    "fahrenheit": false,
    "network_bits": false,
    "confirm_actions": true,
    "unlock": { "for": ["power", "nut", "signal", "actions", "units"], "grace": "every_time" },
    "android": { "dynamic_color": true, "blur": true, "haptics": true, "keep_screen_on": false },
    "source": { "file": "ui-sources.toml", "line": 95 }
  },
  "tabs": ["sources", "control"],
  "header": null,
  "dashboards": [
    {
      "id": "sources",
      "title": "Sources",
      "icon": "terminal",
      "widgets": [
        { "id": "sources/app", "type": "status", "span": 2, "label": "App", "icon": "globe", "caption": true, "format": "text" },
        {
          "id": "sources/zone",
          "type": "value",
          "span": 2,
          "label": "Thermal zone",
          "icon": "thermometer",
          "unit": "m°C",
          "format": "integer"
        },
        { "id": "sources/files", "type": "value", "span": 2, "label": "Files backed up", "icon": "storage", "format": "number" },
        {
          "id": "sources/reads",
          "type": "list",
          "span": 4,
          "label": "Backup and app",
          "icon": "clock",
          "items": [
            { "label": "Last backup", "unit": "s", "format": "time" },
            { "label": "Verified", "format": "bool" },
            { "label": "Exit code", "format": "number" },
            { "label": "App read", "unit": "s", "format": "duration" },
            { "label": "Workers", "format": "text" }
          ]
        },
        {
          "id": "sources/journal",
          "type": "log",
          "span": 4,
          "label": "My journal",
          "scope": "user",
          "level": "notice",
          "lines": 100,
          "search": false
        },
        {
          "id": "sources/app_log",
          "type": "log",
          "span": 4,
          "label": "Example's journal",
          "scope": "unit",
          "unit": "example.service",
          "level": "info",
          "lines": 200,
          "search": true
        }
      ]
    },
    {
      "id": "control",
      "title": "Control",
      "icon": "control",
      "widgets": [
        {
          "id": "control/links",
          "type": "table",
          "span": 4,
          "label": "Links",
          "icon": "globe",
          "source": "links",
          "columns": [{ "field": "name", "format": "text", "grow": true }, { "field": "unit_state", "label": "Unit", "format": "text" }],
          "sorts": [],
          "search": false,
          "hide_empty": true,
          "row_open": "url",
          "row_actions": [
            { "action": "unit.restart", "label": "Restart", "params": { "link": "{id}" } },
            { "open": "unit_log", "label": "Journal" }
          ]
        },
        { "id": "control/journal", "type": "button", "span": 4, "label": "Journal", "icon": "terminal", "open": "journal" }
      ]
    },
    {
      "id": "journal",
      "title": "Journal",
      "icon": "terminal",
      "widgets": [
        {
          "id": "journal/system",
          "type": "log",
          "span": 4,
          "label": "System journal",
          "scope": "system",
          "level": "warning",
          "lines": 200,
          "search": true
        }
      ]
    },
    {
      "id": "unit_log.example",
      "title": "Example",
      "icon": "terminal",
      "widgets": [
        {
          "id": "unit_log.example/log",
          "type": "log",
          "span": 4,
          "label": "Journal",
          "scope": "unit",
          "unit": "example.service",
          "level": "info",
          "lines": 200,
          "search": true
        }
      ]
    }
  ],
  "actions": [
    { "id": "power.poweroff", "name": "Shut down", "kind": "power", "icon": "power", "confirm": true, "unlock": true, "params": [] },
    { "id": "power.reboot", "name": "Restart", "kind": "power", "icon": "restart", "confirm": true, "unlock": true, "params": [] },
    { "id": "power.suspend", "name": "Sleep", "kind": "power", "icon": "moon", "confirm": true, "unlock": true, "params": [] },
    { "id": "power.lock", "name": "Lock", "kind": "power", "icon": "lock", "confirm": true, "unlock": true, "params": [] },
    {
      "id": "profile.set",
      "name": "Power profile",
      "kind": "profile",
      "icon": "bolt",
      "confirm": false,
      "unlock": false,
      "params": [
        {
          "id": "profile",
          "kind": "choice",
          "label": "Profile",
          "choices": [
            { "value": "power-saver", "label": "Power saver" },
            { "value": "balanced", "label": "Balanced" },
            { "value": "performance", "label": "Performance" }
          ]
        }
      ]
    },
    {
      "id": "process.signal",
      "name": "Signal",
      "kind": "signal",
      "icon": "processes",
      "confirm": true,
      "unlock": true,
      "params": [
        { "id": "pid", "kind": "integer", "label": "Process" },
        {
          "id": "signal",
          "kind": "choice",
          "label": "Signal",
          "choices": [{ "value": "term", "label": "Quit" }, { "value": "kill", "label": "Force kill" }]
        },
        { "id": "start", "kind": "integer", "label": "Started", "optional": true }
      ]
    },
    {
      "id": "unit.start",
      "name": "Start",
      "kind": "units",
      "icon": "play",
      "confirm": false,
      "unlock": true,
      "params": [{ "id": "link", "kind": "choice", "label": "Link", "choices": [{ "value": "example", "label": "Example" }] }]
    },
    {
      "id": "unit.stop",
      "name": "Stop",
      "kind": "units",
      "icon": "pause",
      "confirm": false,
      "unlock": true,
      "params": [{ "id": "link", "kind": "choice", "label": "Link", "choices": [{ "value": "example", "label": "Example" }] }]
    },
    {
      "id": "unit.restart",
      "name": "Restart",
      "kind": "units",
      "icon": "restart",
      "confirm": false,
      "unlock": true,
      "params": [{ "id": "link", "kind": "choice", "label": "Link", "choices": [{ "value": "example", "label": "Example" }] }]
    },
    {
      "id": "media.play_pause",
      "name": "Play or pause",
      "kind": "media",
      "icon": "play",
      "confirm": false,
      "unlock": false,
      "params": [{ "id": "player", "kind": "string", "label": "Player" }]
    },
    {
      "id": "media.next",
      "name": "Next",
      "kind": "media",
      "icon": "next",
      "confirm": false,
      "unlock": false,
      "params": [{ "id": "player", "kind": "string", "label": "Player" }]
    },
    {
      "id": "media.previous",
      "name": "Previous",
      "kind": "media",
      "icon": "previous",
      "confirm": false,
      "unlock": false,
      "params": [{ "id": "player", "kind": "string", "label": "Player" }]
    },
    {
      "id": "media.seek",
      "name": "Seek",
      "kind": "media",
      "icon": "play",
      "confirm": false,
      "unlock": false,
      "params": [
        { "id": "player", "kind": "string", "label": "Player" },
        { "id": "position", "kind": "number", "label": "Position", "unit": "s" }
      ]
    },
    {
      "id": "volume.set",
      "name": "Volume",
      "kind": "media",
      "icon": "volume",
      "confirm": false,
      "unlock": false,
      "params": [
        { "id": "level", "kind": "range", "label": "Level", "min": 0, "max": 100, "step": 1, "unit": "%", "optional": true },
        { "id": "muted", "kind": "bool", "label": "Muted", "optional": true }
      ]
    }
  ]
}
