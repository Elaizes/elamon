    "interval_ms": 1000,
    "history_seconds": 600,
    "features": ["control", "displays", "media", "power", "power_profiles", "processes", "units", "ups"],
    "endpoints": ["192.0.2.10", "100.64.0.7", "desk.example.net", "desk.tail0000.ts.net"]
  },
  "role": "admin",
  "control": { "enabled": true, "off_reason": null },
  "profile": {
    "id": "owner",
    "name": "Owner",
    "theme": "system",
    "pure_black": false,
    "animations": true,
    "interval_ms": 1000,
    "fahrenheit": false,
    "network_bits": false,
    "confirm_actions": true,
    "unlock": { "for": ["power", "nut", "signal", "actions", "units"], "grace": "every_time" },
    "android": { "dynamic_color": true, "blur": true, "haptics": true, "keep_screen_on": false },
    "source": { "file": "ui-ups-source.toml", "line": 61 }
  },
  "tabs": ["ups.eco"],
  "header": null,
  "dashboards": [
    {
      "id": "ups.eco",
      "title": "DELTA 3 Max Plus",
      "icon": "battery",
      "widgets": [
        { "id": "ups.eco/status", "type": "status", "span": 2, "label": "Status", "icon": "power", "caption": true, "format": "text" },
        {
          "id": "ups.eco/charge",
          "type": "gauge",
          "span": 2,
          "label": "Battery",
          "icon": "battery",
          "color": "battery",
          "caption": true,
          "unit": "%",
          "format": "percent",
          "min": 0,
          "max": 100
        },
        {
          "id": "ups.eco/power",
          "type": "timeline",
          "span": 4,
          "label": "Power",
          "icon": "power",
          "range": 86400,
          "ranges": ["1h", "24h", "7d", "30d", "1y", "all"]
        },
        {
          "id": "ups.eco/watts",
          "type": "graph",
          "span": 4,
          "label": "Watts",
          "icon": "bolt",
          "series": [
            { "label": "Grid in", "color": "rx", "unit": "W", "format": "watts" },
            { "label": "Output", "color": "tx", "unit": "W", "format": "watts" }
          ],
          "range": 600,
          "height": "medium",
          "min": 0,
          "ranges": ["1h", "24h", "7d", "30d", "1y", "all"]
        },
        {
          "id": "ups.eco/outlets",
          "type": "table",
          "span": 4,
          "label": "Outlets",
          "icon": "power",
          "source": "outlets",
          "columns": [
            { "field": "desc", "format": "text", "grow": true },
            { "field": "status", "label": "State", "format": "text" },
            { "field": "realpower", "label": "Power", "unit": "W", "format": "watts" }
          ],
          "sorts": [],
          "search": false,
          "hide_empty": true
        },
        {
          "id": "ups.eco/switches",
          "type": "group",
          "span": 4,
          "label": "Switches",
          "icon": "power",
          "collapsed": false,
          "widgets": [
            {
              "id": "ups.eco/switches/outlet.eco.1",
              "type": "toggle",
              "span": 2,
              "label": "AC outlets, group 1",
              "action": "nut.command.eco",
              "param": "cmd",
              "on": "outlet.1.load.on",
              "off": "outlet.1.load.off"
            },
            {
              "id": "ups.eco/switches/outlet.eco.2",
              "type": "toggle",
              "span": 2,
              "label": "AC outlets, group 2",
              "action": "nut.command.eco",
              "param": "cmd",
              "on": "outlet.2.load.on",
              "off": "outlet.2.load.off"
            }
          ]
        },
        {
          "id": "ups.eco/charge_limit",
          "type": "slider",
          "span": 4,
          "label": "Charge limit",
          "icon": "battery",
          "action": "nut.set.eco.experimental.battery.charge.max",
          "param": "value"
        }
      ]
    }
  ],
  "actions": [
    { "id": "power.poweroff", "name": "Shut down", "kind": "power", "icon": "power", "confirm": true, "unlock": true, "params": [] },
    { "id": "power.reboot", "name": "Restart", "kind": "power", "icon": "restart", "confirm": true, "unlock": true, "params": [] },
    { "id": "power.suspend", "name": "Sleep", "kind": "power", "icon": "moon", "confirm": true, "unlock": true, "params": [] },
