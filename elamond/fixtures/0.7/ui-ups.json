      "params": [
        { "id": "level", "kind": "range", "label": "Level", "min": 0, "max": 100, "step": 1, "unit": "%", "optional": true },
        { "id": "muted", "kind": "bool", "label": "Muted", "optional": true }
      ]
    },
    {
      "id": "nut.command.eco",
      "name": "DELTA 3 Max Plus",
      "kind": "nut",
      "icon": "power",
      "confirm": true,
      "unlock": true,
      "params": [
        {
          "id": "cmd",
          "kind": "choice",
          "label": "Command",
          "choices": [
            { "value": "beeper.enable", "label": "Turn the beeper on" },
            { "value": "beeper.disable", "label": "Turn the beeper off" },
            { "value": "outlet.1.load.on", "label": "Turn on AC outlets, group 1" },
            { "value": "outlet.1.load.off", "label": "Turn off AC outlets, group 1", "confirm_text": "outlet.1.load.off" },
            { "value": "outlet.2.load.on", "label": "Turn on AC outlets, group 2" },
            { "value": "outlet.2.load.off", "label": "Turn off AC outlets, group 2" }
          ]
