    {
      "id": "nut.set.eco.experimental.output.xboost",
      "name": "X-Boost: run heavy AC loads at a lower voltage",
      "kind": "nut",
      "icon": "control",
      "confirm": true,
      "unlock": true,
      "params": [
        {
          "id": "value",
          "kind": "choice",
