      "icon": "next",
      "confirm": false,
      "unlock": false,
      "params": [{ "id": "player", "kind": "string", "label": "Player" }]
    },
    {
      "id": "media.previous",
      "name": "Previous",
      "kind": "media",
      "icon": "previous",
      "confirm": false,
      "unlock": false,
      "params": [{ "id": "player", "kind": "string", "label": "Player" }]
    },
    {
      "id": "media.seek",
      "name": "Seek",
