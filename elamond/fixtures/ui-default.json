{
  "version": "5c9de3620205bd8e",
  "service": {
    "id": "0123456789abcdef0123456789abcdef",
    "name": "fixture",
    "version": "9.9.9",
    "interval_ms": 1000,
    "history_seconds": 600,
    "features": ["displays", "media", "power", "power_profiles", "processes", "units"]
  },
  "role": "admin",
  "control": { "enabled": false, "off_reason": "settings" },
  "profile": {
    "id": "default",
    "name": "Default",
    "theme": "system",
    "pure_black": false,
    "animations": true,
    "interval_ms": 1000,
    "fahrenheit": false,
    "network_bits": false,
    "confirm_actions": true,
    "unlock": { "for": ["power", "signal", "actions", "units"], "grace": "every_time" },
    "android": { "dynamic_color": true, "blur": true, "haptics": true, "keep_screen_on": false }
  },
  "tabs": ["overview", "processes", "sensors", "control"],
  "header": "header",
