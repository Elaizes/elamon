          "expand": [
            { "field": "cmd", "label": "Command", "format": "text" },
            { "field": "user", "label": "User", "format": "text" },
            { "field": "pid", "label": "PID", "format": "integer" },
            { "field": "ppid", "label": "Parent", "format": "integer" },
            { "field": "status", "label": "State", "format": "text" },
            { "field": "start", "label": "Started", "unit": "s", "format": "time" },
            { "field": "read", "label": "Disk read", "unit": "B/s", "format": "rate" },
            { "field": "write", "label": "Disk write", "unit": "B/s", "format": "rate" },
            { "field": "gpu", "label": "GPU", "unit": "%", "format": "percent" },
            { "field": "gpu_mem", "label": "GPU memory", "unit": "B", "format": "bytes" }
          ]
        }
      ]
