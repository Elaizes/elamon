    {
      "id": "overview",
      "title": "Overview",
      "icon": "overview",
      "widgets": [
        {
          "id": "overview/cpu",
          "type": "gauge",
          "span": 2,
          "label": "CPU",
          "icon": "chip",
          "color": "cpu",
          "open": "cpu",
          "caption": true,
          "unit": "%",
          "format": "percent",
          "min": 0,
          "max": 100
        },
        {
          "id": "overview/memory",
          "type": "gauge",
          "span": 2,
          "label": "Memory",
          "icon": "memory",
          "color": "memory",
          "open": "memory",
          "caption": true,
          "unit": "%",
          "format": "percent",
          "min": 0,
          "max": 100
        },
        {
          "id": "overview/gpus.nvidia",
          "type": "value",
          "span": 2,
          "label": "Some GPU",
          "icon": "gpu",
          "color": "gpu",
          "open": "gpu.nvidia",
          "caption": true,
          "unit": "%",
          "format": "percent",
          "spark": true
        },
        {
          "id": "overview/temperature",
          "type": "value",
          "span": 2,
          "label": "Temperature",
          "icon": "thermometer",
          "color": "hot",
          "open": "sensors",
          "caption": true,
          "unit": "°C",
          "format": "temp",
          "spark": true
        },
        {
          "id": "overview/network",
          "type": "graph",
          "span": 4,
          "label": "Network",
          "icon": "network",
          "color": "rx",
          "open": "network",
          "caption": true,
          "series": [
            { "label": "Download", "color": "rx", "unit": "B/s", "format": "rate" },
            { "label": "Upload", "color": "tx", "unit": "B/s", "format": "rate" }
          ],
          "range": 600,
          "height": "small",
          "floor": 65536
        },
        {
          "id": "overview/storage",
          "type": "table",
          "span": 4,
          "label": "Storage",
          "icon": "storage",
          "color": "read",
          "open": "storage",
          "caption": true,
          "source": "disks",
          "columns": [
            { "field": "mount", "format": "text", "grow": true },
            { "field": "available", "label": "free", "unit": "B", "format": "bytes" },
            { "field": "percent", "unit": "%", "format": "percent", "bar": { "max": 100 } }
          ],
          "sorts": [],
          "search": false,
          "hide_empty": false
        },
        {
          "id": "overview/battery",
          "type": "meter",
          "span": 4,
          "label": "Battery",
          "icon": "battery",
          "color": "battery",
          "open": "battery",
          "caption": true,
          "unit": "%",
          "format": "percent",
          "min": 0,
          "max": 100
        }
      ]
    },
    {
      "id": "processes",
      "title": "Processes",
      "icon": "processes",
      "widgets": [
        {
          "id": "processes/table",
          "type": "table",
          "span": 4,
          "source": "processes",
          "columns": [
            { "field": "name", "format": "text", "grow": true },
            { "field": "cpu", "label": "CPU", "unit": "%", "format": "percent", "bar": { "max": 25 } },
            { "field": "mem", "label": "Memory", "unit": "B", "format": "bytes" }
          ],
          "sort": { "field": "cpu", "desc": true },
          "sorts": ["cpu", "mem", "gpu", "io"],
          "sort_labels": { "cpu": "CPU", "gpu": "GPU", "io": "Disk", "mem": "Memory" },
          "search": true,
          "search_fields": ["name", "cmd", "user", "pid"],
          "hide_empty": false,
          "row_actions": [
            { "action": "process.signal", "label": "Quit", "params": { "pid": "{pid}", "signal": "term", "start": "{start}" } },
            { "action": "process.signal", "label": "Force kill", "params": { "pid": "{pid}", "signal": "kill", "start": "{start}" } }
